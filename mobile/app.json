{
  "expo": {
    "name": "Goyo - Korean Practice",
    "slug": "goyo-korean-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../public/icons/icon-512.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "../public/icons/icon-512.png",
      "resizeMode": "contain",
      "backgroundColor": "#059669"
    },
    "assetBundlePatterns": ["../public/audio/**/*", "../public/icons/**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goyo.korean"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "../public/icons/maskable-512.png",
        "backgroundColor": "#059669"
      },
      "package": "com.goyo.korean"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "../public/icons/icon-192.png"
    }
  }
}
